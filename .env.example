# Use sqlite:///demo.db for quick local demo without MySQL
# OR use the individual DB_* vars below for MySQL
DATABASE_URL=sqlite:///demo.db

# Flask
SECRET_KEY=replace-with-a-long-random-string
FLASK_ENV=development

# MySQL database connection (only used if DATABASE_URL is not set)
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medtimeline_ai

# Optional: overrides the individual DB_* vars above with a full URL if set.
# Example (MySQL):   DATABASE_URL=mysql+pymysql://root:password@localhost:3306/medtimeline_ai
# Example (SQLite, for a quick local demo only): DATABASE_URL=sqlite:///demo.db
# DATABASE_URL=

# Optional: enables a richer narrative AI Clinical Summary via the Anthropic API.
# Leave blank to use the built-in rule-based summary engine (works fully offline).
ANTHROPIC_API_KEY=
